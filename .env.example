# Copier en .env (jamais commité). Valeurs de dev alignées sur docker-compose.yml.

# PostgreSQL (base unique — ADR-0001)
DATABASE_URI=postgres://maximerit:maximerit_dev@localhost:5432/maximerit

# Payload CMS (Phase 3b) — générer un secret fort en prod
PAYLOAD_SECRET=dev_secret_change_me

# Meilisearch (recherche vivier — Phase 5)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey_dev_change_me

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview (mode brouillon CMS)
PREVIEW_SECRET=change_me_preview_secret

# Stockage privé des CV et lettres (production) — Vercel Blob, store « Private ».
# Ajouté automatiquement par Vercel quand le store est créé/connecté au projet. Vide en local : disque (cv-uploads/).
BLOB_READ_WRITE_TOKEN=

# Captcha Cloudflare Turnstile (formulaires candidature + demande d'entreprise). Vide en local : captcha désactivé.
# Clés de test Cloudflare (toujours valides) : site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tracking (Phase 8) — laisser vide en local (aucun script chargé, aucune mesure)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
